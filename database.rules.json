{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        "studyData": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.isString() && newData.val().length <= 5000000"
        }
      }
    }
  }
}
